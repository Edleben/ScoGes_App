# Supabase public browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret key (sb_secret_...). Used only by isolated live test fixtures.
# Never expose it with NEXT_PUBLIC_. Application requests use user sessions and RLS.
SUPABASE_SECRET_KEY=

# Application URL used for auth redirects and invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional observability DSN for future Sentry/OpenTelemetry setup.
SENTRY_DSN=

# Server/test tooling only. Use the project's TLS PostgreSQL connection string.
# Never expose this variable with NEXT_PUBLIC_. Required by pnpm test:db.
DATABASE_URL=

# Optional CA override for database tests; defaults to the bundled public Supabase CA.
DATABASE_SSL_ROOT_CERT=

# Server-only invitation delivery. SMTP_FROM accepts an email or Name <email>.
# Port 465 uses implicit TLS; 587 requires STARTTLS. Never disable certificate validation.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
