# Supabase public browser-safe configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only key. Never expose it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-only-in-local-or-secure-runtime

# Application URL used for auth redirects and invitation links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional observability DSN for future Sentry/OpenTelemetry setup.
SENTRY_DSN=
